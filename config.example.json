{
    "opencanary": {
        "log_file": "/opt/opencanary/opencanary.log",
        "db_file": "/opt/canaryguard/canaryguard.db"
    },
    "alerts": {
        "enabled": true,
        "min_severity": "medium",
        "cooldown_seconds": 60,
        "retries": 3,
        "mute_categories": [],
        "night_escalation": true,
        "night_start": "23:00",
        "night_end": "07:00",
        "night_floor": "high",
        "batch_limit": 3,
        "batch_window_seconds": 300,
        "screenshot_categories": [
            "usb:connect",
            "auth:fail",
            "usb:exec"
        ],
        "digest_time": "08:00",
        "geoip": true,
        "notify_on_start": true,
        "telegram": {
            "enabled": true,
            "bot_token": "REPLACE_WITH_YOUR_BOT_TOKEN",
            "chat_id": "REPLACE_WITH_YOUR_CHAT_ID"
        },
        "discord": {
            "enabled": false,
            "webhook_url": ""
        },
        "slack": {
            "enabled": false,
            "webhook_url": ""
        },
        "email": {
            "enabled": false,
            "smtp_host": "",
            "smtp_port": 587,
            "username": "",
            "password": "",
            "from_addr": "",
            "to_addr": ""
        },
        "inline_buttons": true
    },
    "siem": {
        "elasticsearch": {
            "enabled": false,
            "url": "http://localhost:9200",
            "index": "opencanary-events"
        },
        "splunk": {
            "enabled": false,
            "hec_url": "",
            "token": ""
        },
        "http": {
            "enabled": false,
            "url": "",
            "headers": {}
        },
        "syslog": {
            "enabled": false,
            "host": "127.0.0.1",
            "port": 514,
            "protocol": "udp"
        },
        "max_queue": 1000,
        "scrub_secrets": true,
        "verify_tls": true
    },
    "honeytokens": {
        "url_tokens": [
            {
                "id": "tok_backup",
                "path": "/secret/backup.tar.gz",
                "label": "Fake backup archive",
                "severity": "critical"
            }
        ],
        "credential_tokens": [
            {
                "id": "tok_admin",
                "username": "admin",
                "password": "admin1",
                "label": "Fake admin creds",
                "severity": "critical"
            }
        ]
    },
    "dashboard": {
        "host": "0.0.0.0",
        "port": 8080,
        "auto_start": true,
        "username": "admin",
        "password": "CHANGE_ME_STRONG_PASSWORD",
        "noauth_allow_remote": false,
        "trusted_networks": [],
        "secret_key": "RANDOM_LONG_STRING"
    },
    "ingest": {
        "poll_seconds": 2,
        "start_from_end": true
    },
    "decoys": {
        "monitor_enabled": true,
        "folder": "/opt/canaryguard/CanaryDecoys",
        "beacon_host": "YOUR_DDNS_DOMAIN_OR_SERVER_IP",
        "cooldown_seconds": 60
    },
    "protect": {
        "folder_monitor": true,
        "folders": [
            "/home/user/Desktop",
            "/home/user/Documents",
            "/home/user/Downloads"
        ],
        "keylogger": true,
        "key_buffer_max": 200,
        "key_flush_secs": 5,
        "sensitive_keywords": [
            "password",
            "passwd",
            "login",
            "token",
            "secret",
            "admin"
        ]
    },
    "process_monitor": {
        "enabled": true,
        "poll_seconds": 3,
        "notify_start": true,
        "notify_exit": true,
        "cooldown_seconds": 30,
        "ignore": [],
        "rarity_alerts": true,
        "rarity_warmup": 200
    },
    "usb_monitor": {
        "enabled": true,
        "poll_seconds": 3,
        "cooldown_seconds": 30,
        "notify_connect": true,
        "notify_files": true,
        "notify_explorer_open": true,
        "notify_exec": true,
        "extra_folders": [],
        "watch_drives": [
            "C:",
            "H:"
        ],
        "block_unknown_writes": false
    },
    "netmon": {
        "enabled": true,
        "poll_seconds": 5,
        "cooldown_seconds": 60,
        "notify": true,
        "ignore": []
    },
    "clipboard_monitor": {
        "enabled": true,
        "poll_seconds": 1.5,
        "mode": "keywords",
        "cooldown_seconds": 20,
        "keywords": null
    },
    "telegram_bot": {
        "enabled": true,
        "owner": "supervisor",
        "allowed_chats": [],
        "admin_user_ids": []
    },
    "lan_monitor": {
        "enabled": true,
        "poll_seconds": 60,
        "notify": true,
        "known_macs": []
    },
    "downloads_monitor": {
        "enabled": true,
        "notify": true,
        "folder": null,
        "extensions": []
    },
    "cam_monitor": {
        "enabled": true,
        "poll_seconds": 3,
        "notify": true
    },
    "panic": {
        "enabled": true,
        "idle_lock_minutes": 15,
        "notify_idle_lock": false,
        "lock_on_bruteforce": true,
        "lock_on_usb_grab": true
    },
    "secrets": {
        "enabled": true,
        "max_file_kb": 512,
        "watch_strings": [],
        "extra_patterns": [],
        "embed_enabled": true,
        "embed_folder": "/opt/canaryguard/CanaryDecoys/embedded"
    },
    "ransomware_monitor": {
        "enabled": true
    },
    "ransomware": {
        "threshold": 40,
        "window_seconds": 60,
        "kill_network": false,
        "network_adapter": "eth0",
        "entropy_trigger": 8,
        "entropy_threshold": 7.5,
        "ext_ratio": 0.6
    },
    "staging_monitor": {
        "enabled": true
    },
    "staging": {
        "min_size_mb": 10,
        "folders": [
            "Documents",
            "Downloads",
            "Desktop"
        ]
    },
    "browser_monitor": {
        "enabled": true
    },
    "browser": {
        "poll_seconds": 5
    },
    "persist_monitor": {
        "enabled": true
    },
    "persist": {
        "poll_seconds": 60
    },
    "theft_monitor": {
        "enabled": true
    },
    "theft": {
        "poll_seconds": 2,
        "idle_before": 120
    },
    "evidence_monitor": {
        "enabled": true
    },
    "evidence": {
        "time": "02:00",
        "max_mb": 10,
        "encryption_key": ""
    },
    "ipblock": {
        "enabled": true,
        "max_fails": 5,
        "window_seconds": 300,
        "block_minutes": 60
    },
    "analytics": {
        "enabled": true,
        "rarity_boost": true,
        "rarity_min": 0.8,
        "rarity_max_count": 2,
        "changepoint": true,
        "changepoint_cooldown_seconds": 300,
        "spray_detection": true,
        "spray_window_seconds": 600,
        "spray_min_ips": 5,
        "spray_min_users": 10
    },
    "retention": {
        "enabled": true,
        "interval_hours": 24,
        "vacuum": false,
        "days": {}
    },
    "threatintel": {
        "enabled": false,
        "feeds": []
    },
    "playbooks": {
        "enabled": false,
        "rules": [
            {
                "name": "block-credential-spray",
                "when": {
                    "category": [
                        "credential_spray"
                    ],
                    "severity_gte": "high",
                    "cooldown_minutes": 60
                },
                "then": [
                    {
                        "action": "block_ip",
                        "minutes": 60
                    },
                    {
                        "action": "notify",
                        "text": "credential spray detected — IP blocked for 1h"
                    }
                ]
            }
        ]
    }
}
